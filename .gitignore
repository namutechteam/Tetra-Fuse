# Python
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# OS
.DS_Store
._*

# large training artifacts (not part of the figure/table reproduction bundle)
checkpoints*/
lightning_logs/
logs/


# archived / superseded material (kept locally, not part of the public release)
**/archive/

# notebook run outputs that duplicate the canonical copies in figures/ and data/
# (the notebook writes PNGs and recompute_data into its own dir when executed in place;
#  the release keeps only figures/*.png, tables/*, and data/recompute_data/ as canonical)
notebooks/*.png
notebooks/*.pdf
notebooks/recompute_data/
notebooks/polaris_leaderboard_full.json

# generated table workbook (regenerated by the notebook; not version-controlled)
tables/supplementary_tables.xlsx
notebooks/regenerate_paper_materials.ipynb
